# --- Telegram ---
BOT_TOKEN=123456:AA-your-telegram-bot-token
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=111111111

# --- Режим работы ---
# DRY_RUN=1 — ничего реально не отправляется в Авито, работает встроенный
# симулятор чатов. Это только НАЧАЛЬНОЕ значение: дальше режим
# переключается в самом боте («Настройки» → «Перейти в боевой режим»)
# и хранится в базе.
DRY_RUN=1

# --- Лимиты и темп ---
DAILY_LIMIT=50
SEND_INTERVAL_SECONDS=45
POLL_INTERVAL_SECONDS=60
FOLLOWUP_AFTER_HOURS=24

# --- Хранилище ---
DB_PATH=data/bot.sqlite3
# Ключ шифрования секретов аккаунтов Авито в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# --- Сеть ---
AVITO_API_BASE=https://api.avito.ru
# Прокси для исходящих запросов к API Авито (если у вас закрытый контур).
# Формат: http://user:pass@host:port
PROXY_URL=
